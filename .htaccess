Options -MultiViews
RewriteEngine On

# Keep the homepage at the domain root.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Permanently redirect legacy .html addresses to clean URLs.
RewriteCond %{THE_REQUEST} \s/+(.+)\.html(?:[\s?]) [NC]
RewriteRule ^(.+)\.html$ /$1/ [R=301,L,NE]

# Use trailing slashes for extensionless pages.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^(.+[^/])$ /$1/ [R=301,L,NE]

# Serve an existing page.html from /page/ without exposing the filename.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ $1.html [L]
